[Unit]
Description=RTCM Forwarder
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/rtcm-forwarder
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/rtcm-forwarder/.venv/bin/python /home/pi/rtcm-forwarder/rtcm-forwarder.py --config /home/pi/rtcm-forwarder/config.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
